# Personal Arch package for this fork. Builds the committed `main` branch of
# the repo this file lives in. Use ./install_or_update.sh and ./uninstall.sh.
pkgname=kenku-fm-fluxer
pkgver=1.5.5.r945.gb1e5e36
pkgrel=1
pkgdesc="Kenku FM fork that plays to Fluxer voice channels"
arch=('x86_64')
url="https://github.com/Gtaray/kenku-fm"
license=('GPL-3.0-only')
depends=('gtk3' 'nss' 'alsa-lib')
makedepends=('git' 'nodejs' 'yarn')
optdepends=('pipewire: Kenku FM virtual microphone')
provides=('kenku-fm')
conflicts=('kenku-fm')
# Stripping breaks the bundled Electron binary
options=('!strip' '!debug')
source=("kenku-fm::git+file://${startdir%/packaging/arch}#branch=main"
        "kenku-fm.desktop")
sha256sums=('SKIP'
            'SKIP')

pkgver() {
  cd kenku-fm
  printf "%s.r%s.g%s" \
    "$(node -p "require('./package.json').version")" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd kenku-fm
  yarn install --frozen-lockfile --non-interactive
  yarn package
}

package() {
  cd kenku-fm

  install -d "$pkgdir/opt/kenku-fm" "$pkgdir/usr/bin"
  cp -r --no-preserve=ownership "out/Kenku FM-linux-x64/." "$pkgdir/opt/kenku-fm/"
  ln -s /opt/kenku-fm/kenku-fm "$pkgdir/usr/bin/kenku-fm"

  install -Dm644 "$srcdir/kenku-fm.desktop" \
    "$pkgdir/usr/share/applications/kenku-fm.desktop"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "src/assets/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/kenku-fm.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
